# Set the key for whichever provider you want to drive the agent.
# The model string selects the provider (LiteLLM routing).

MIGRATION_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# MIGRATION_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# MIGRATION_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, Ollama):
# MIGRATION_MODEL=openai/<model-name>
# MIGRATION_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=

# None of this is needed to reproduce the reported results:
#   make reproduce      replays the committed cache offline
